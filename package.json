{
  "name": "dockyard-mcp",
  "version": "0.1.5",
  "author": "bryanthaboi",
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bryanthaboi/dockyard.git"
  },
  "homepage": "https://github.com/bryanthaboi/dockyard#readme",
  "bugs": {
    "url": "https://github.com/bryanthaboi/dockyard/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "dashboard/dist",
    "skills",
    "dockyardlogo.txt",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "work-order",
    "dashboard",
    "server",
    "local",
    "ai",
    "model-context-protocol",
    "cursor",
    "codex",
    "claude-code",
    "gemini",
    "windsurf",
    "zed"
  ],
  "description": "Local-first MCP work-order server, CLI, and dashboard (GPL-3.0)",
  "type": "module",
  "bin": {
    "dockyard": "./dist/cli.js",
    "dockyard-mcp": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && vite build --config dashboard/vite.config.ts",
    "prepack": "npm run build",
    "link": "pnpm link --global",
    "start": "node dist/index.js",
    "dev": "concurrently -k \"tsx watch src/index.ts\" \"vite dev --config dashboard/vite.config.ts --port 5173\"",
    "dev:server": "tsx watch src/index.ts",
    "cli": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.4",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^13.1.0",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
